@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(nlohmann_json 3.12.0)

# Every platform installed here shares one set of headers; only the library
# differs. Resolve the caller's ABI tag with the code that produced the name.
include("${CMAKE_CURRENT_LIST_DIR}/PlatformSuffix.cmake")
ink_resolve_installed_suffix("${CMAKE_CURRENT_LIST_DIR}" "ink-targets" _ink_suffix)

set(_ink_targets "${CMAKE_CURRENT_LIST_DIR}/ink-targets-${_ink_suffix}.cmake")

if(NOT EXISTS "${_ink_targets}")
    file(GLOB _ink_have "${CMAKE_CURRENT_LIST_DIR}/ink-targets-*.cmake")
    list(TRANSFORM _ink_have REPLACE "^.*/ink-targets-(.+)\\.cmake$" "\\1")
    list(FILTER _ink_have EXCLUDE REGEX "-(debug|release|relwithdebinfo|minsizerel)$")
    message(FATAL_ERROR "ink is not installed for '${_ink_suffix}'; have: ${_ink_have}")
endif()

include("${_ink_targets}")

unset(_ink_suffix)
unset(_ink_targets)
unset(_ink_have)

check_required_components(ink)